{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pervan-yapi-market",
  "compatibility_date": "2024-09-23",
  "main": "worker.js",
  "routes": [
    {
      "pattern": "pervanyapi.com/*",
      "zone_name": "pervanyapi.com"
    },
    {
      "pattern": "www.pervanyapi.com/*",
      "zone_name": "pervanyapi.com"
    }
  ],
  "assets": {
    "directory": ".",
    "run_worker_first": true,
    "exclude": [
      ".git/**",
      "scratch/**",
      ".gitignore",
      "wrangler.jsonc",
      ".assetsignore"
    ]
  }
}